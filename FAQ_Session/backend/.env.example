# ═══════════════════════════════════════════════════════════════════════════
# FAQ RAG Backend — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─────────────────────────────────────────────────────────────────────────────
# Database — MongoDB
# ─────────────────────────────────────────────────────────────────────────────
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# Get from: https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/faq_db?retryWrites=true&w=majority

# ─────────────────────────────────────────────────────────────────────────────
# Authentication — betterAuth Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Secret key for signing sessions (minimum 32 characters)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_random_secret_here_minimum_32_characters_long

# Base URL of your API (used for OAuth callbacks)
# Must match your deployment URL in production
BETTER_AUTH_URL=http://localhost:5000

# ─────────────────────────────────────────────────────────────────────────────
# OAuth Providers — Google OAuth 2.0
# ─────────────────────────────────────────────────────────────────────────────
# Setup Guide:
# 1. Go to: https://console.cloud.google.com
# 2. Create a new project or select existing one
# 3. Enable the "Google+ API"
# 4. Create OAuth 2.0 credentials (type: Web Application)
# 5. Add authorized redirect URIs:
#    - http://localhost:5000/api/auth/oauth/google/callback (development)
#    - https://yourdomain.com/api/auth/oauth/google/callback (production)
# 6. Copy Client ID and Client Secret below

GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# CORS & Frontend Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Frontend origin for CORS (should match your React app URL)
CORS_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# AI & LLM Configuration — Google Generative AI
# ─────────────────────────────────────────────────────────────────────────────
# Get from: https://ai.google.dev (Google AI Studio)
# Needed for: PDF ingestion, FAQ embeddings, RAG queries
GOOGLE_API_KEY=your_google_ai_api_key_here

# ═══════════════════════════════════════════════════════════════════════════
# Common Setup Steps:
# ═══════════════════════════════════════════════════════════════════════════
# 1. Copy this file to .env in FAQ_Session/backend/
# 2. Fill in all required variables (those without defaults)
# 3. Run: npm install
# 4. Run: npm run dev (development) or npm run build && npm start (production)
# ═══════════════════════════════════════════════════════════════════════════
