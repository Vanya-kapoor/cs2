# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/faq_db?retryWrites=true&w=majority

# Auth — generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_random_secret_here_minimum_32_characters_long
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Frontend origin for CORS
CORS_ORIGIN=http://localhost:3000

# Google AI API key for Gemini embeddings (ai.google.dev)
GOOGLE_API_KEY=your_google_ai_api_key_here

# MongoDB _id of the system admin user (required for running the script for faq extraction from pdf)
SYSTEM_ADMIN_ID=your_system_admin_id_here

# SMTP — for sending emails (e.g. Brevo, Gmail)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=you@gmail.com
EMAIL_FROM_NAME=FAQ System

# ─── Rate Limiting (optional, all have safe defaults) ───────────────────
# Global rate limit: 100 requests per 15 minutes (applies to all routes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Auth routes rate limit: 15 requests per 15 minutes (brute-force protection)
# Applies to: POST /api/auth/sign-up/email, POST /api/auth/sign-in/email, etc.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Chat/RAG routes rate limit: 5 requests per 1 minute (Gemini API cost protection)
# Applies to: POST /api/chat
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=10

# Query submission rate limit: 5 requests per 15 minutes (anti-spam for public endpoint)
# Applies to: POST /api/queries (public, unauthenticated)
QUERY_RATE_LIMIT_WINDOW_MS=900000
QUERY_RATE_LIMIT_MAX=10
